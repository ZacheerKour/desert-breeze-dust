/tools/ghidra/
/tools/jdk/
/tools/xemu/
/tools/xdvdfs/
/_external/
/.venv-recomp/
__pycache__/
*.pyc

# ---- Nested upstream git metadata of the vendored toolkit ----
/xboxrecomp/.git.upstream/

